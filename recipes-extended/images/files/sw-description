software = {
    version = "2.0.0";
    description = "FRDM-IMX93 A/B OTA (no rescue tier)";

    hardware-compatibility: [ "1.0" ];

    stable: {
        /* ---- writes slot B (run this when A is active) ---- */
        slot_b: {
            files: (
                {
                    filename = "fitImage";
                    path = "/fitImage";
                    sha256 = "$swupdate_get_sha256(fitImage)";
                    device = "/dev/mmcblk1p2";          /* boot_b */
                    filesystem = "vfat";
                    encrypted = true;
                    ivt = "ff28037cc45a8117c4e10c3d110bfb27";
                }
            );
            images: (
                {
                    filename = "swupdate-image-@@MACHINE@@.rootfs.ext4.gz";
                    sha256 = "$swupdate_get_sha256(swupdate-image-@@MACHINE@@.rootfs.ext4.gz)";
                    device = "/dev/mmcblk1p4";          /* root_b */
                    compressed = "zlib";
                    installed-directly = true;
                    encrypted = true;
                    ivt = "ff28037cc45a8117c4e10c3d110bfb27";
                }
            );
            scripts: (
                {
                    filename = "preinst.sh";
                    type = "shellscript";
                    sha256 = "$swupdate_get_sha256(preinst.sh)";
                },
                {
                    filename = "postinst.sh";
                    type = "shellscript";
                    sha256 = "$swupdate_get_sha256(postinst.sh)";
                }
            );
            bootenv: (
                { name = "boot_slot";         value = "B"; },
                { name = "upgrade_available"; value = "1"; },
                { name = "bootcount";         value = "0"; },
                { name = "fallback_done";     value = "0"; }
            );
        };

        /* ---- writes slot A (run this when B is active) ---- */
        slot_a: {
            files: (
                {
                    filename = "fitImage";
                    path = "/fitImage";
                    sha256 = "$swupdate_get_sha256(fitImage)";
                    device = "/dev/mmcblk1p1";          /* boot_a */
                    filesystem = "vfat";
                    encrypted = true;
                    ivt = "ff28037cc45a8117c4e10c3d110bfb27";
                }
            );
            images: (
                {
                    filename = "swupdate-image-@@MACHINE@@.rootfs.ext4.gz";
                    sha256 = "$swupdate_get_sha256(swupdate-image-@@MACHINE@@.rootfs.ext4.gz)";
                    device = "/dev/mmcblk1p3";          /* root_a */
                    compressed = "zlib";
                    installed-directly = true;
                    encrypted = true;
                    ivt = "ff28037cc45a8117c4e10c3d110bfb27";
                }
            );
            scripts: (
                {
                    filename = "preinst.sh";
                    type = "shellscript";
                    sha256 = "$swupdate_get_sha256(preinst.sh)";
                },
                {
                    filename = "postinst.sh";
                    type = "shellscript";
                    sha256 = "$swupdate_get_sha256(postinst.sh)";
                }
            );
            bootenv: (
                { name = "boot_slot";         value = "A"; },
                { name = "upgrade_available"; value = "1"; },
                { name = "bootcount";         value = "0"; },
                { name = "fallback_done";     value = "0"; }
            );
        };
    };
};