# FRDM-IMX93 A/B with rescue region + data (GPT).
#
# Raw region (no partitions):
#   32K   .. 8M   : imx-boot container
#   8M    .. 120M : rescue kernel(0x4000) + dtb(0x19000) + ramdisk(0x1B000)
# Partitions start at 120 MiB:
#   p1 BOOT_A   p2 ROOTFS_A   p3 BOOT_B   p4 ROOTFS_B   p5 DATA
#
part u-boot    --source rawcopy --sourceparams="file=imx-boot" --ondisk mmcblk --no-table --align ${IMX_BOOT_SEEK}
part /boot     --source bootimg-partition --ondisk mmcblk --fstype=vfat --label BOOT_A   --active --align 8192 --offset 122880 --fixed-size ${BOOT_PARTITION_SIZE_MIB}
part /         --source rootfs --ondisk mmcblk --fstype=ext4 --label ROOTFS_A --align 8192 --fixed-size ${ROOTFS_PARTITION_SIZE_MIB}
part /boot_b   --source bootimg-partition --ondisk mmcblk --fstype=vfat --label BOOT_B   --align 8192 --fixed-size ${BOOT_PARTITION_SIZE_MIB}
part /rootfs_b --source rootfs --ondisk mmcblk --fstype=ext4 --label ROOTFS_B --align 8192 --fixed-size ${ROOTFS_PARTITION_SIZE_MIB}
part /data     --ondisk mmcblk --fstype=ext4 --label DATA --align 8192 --fixed-size ${DATA_PARTITION_SIZE_MIB}
bootloader --ptable gpt