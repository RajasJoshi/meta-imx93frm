Upstream-Status: Inappropriate [i.MX swupdate specific enablement]
From aca03295162a6ae4c42eb08d5da488cee8c695d1 Mon Sep 17 00:00:00 2001
From: Rajas Joshi <rajasj99@gmail.com>
Date: Wed, 22 Jul 2026 21:56:18 +0100
Subject: [PATCH] imx93-default-env-lf-6.12.34-2.1.0

---
 board/freescale/imx93_frdm/imx93_frdm.c   |  4 ++++
 board/freescale/imx93_frdm/imx93_frdm.env | 26 +++++++++++++++++++++++
 2 files changed, 30 insertions(+)

diff --git a/board/freescale/imx93_frdm/imx93_frdm.c b/board/freescale/imx93_frdm/imx93_frdm.c
index 505366c17ca..a53decd456a 100644
--- a/board/freescale/imx93_frdm/imx93_frdm.c
+++ b/board/freescale/imx93_frdm/imx93_frdm.c
@@ -21,6 +21,8 @@
 #include <dwc3-uboot.h>
 #include <asm/gpio.h>
 #include <adc.h>
+#include <timestamp.h>
+#include <version.h>
 
 DECLARE_GLOBAL_DATA_PTR;
 
@@ -340,6 +342,8 @@ int board_late_init(void)
 	env_set("sec_boot", "yes");
 #endif
 
+env_set("u-boot_version", PLAIN_VERSION"("U_BOOT_DATE"-"U_BOOT_TIME")");
+
 #ifdef CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG
 	env_set("board_name", "11X11_FRDM");
 	env_set("board_rev", "iMX93");
diff --git a/board/freescale/imx93_frdm/imx93_frdm.env b/board/freescale/imx93_frdm/imx93_frdm.env
index 47be10216ec..7bb48022bd4 100644
--- a/board/freescale/imx93_frdm/imx93_frdm.env
+++ b/board/freescale/imx93_frdm/imx93_frdm.env
@@ -43,6 +43,7 @@ mmcpart=1
 mmcroot=/dev/mmcblk1p2 rootwait rw
 mmcautodetect=yes
 mmcargs=setenv bootargs ${jh_clk} ${mcore_clk} console=${console} root=${mmcroot}
+	cur_slot=${bootslot} U-Boot_ver=${u-boot_version}
 prepare_mcore=setenv mcore_clk clk-imx93.mcore_booted
 kernel_addr_r=CONFIG_SYS_LOAD_ADDR
 loadbootscript=fatload mmc ${mmcdev}:${mmcpart} ${loadaddr} ${script};
@@ -85,8 +86,53 @@ netboot=
 			echo WARN: Cannot load the DT;
 		fi;
 	fi;
+bootslot=dualA
+bootlimit=3
+u-boot_version=null
+usb_port=1
+post_opt=saveenv
+
+adjustbootsourceA=echo Boot slot A; setenv mmcpart 1; setenv mmcroot /dev/mmcblk${mmcdev}p2 rootwait rw
+adjustbootsourceB=echo Boot slot B; setenv mmcpart 3; setenv mmcroot /dev/mmcblk${mmcdev}p4 rootwait rw
+adjustbootsource=if test ${bootslot} = dualB; then
+			run adjustbootsourceB;
+		else
+			run adjustbootsourceA;
+		fi;
+
+loadswuimage=mmc read ${loadaddr} 0x4000 0x15000
+loadswufdt=mmc read ${fdt_addr} 0x19000 0x200
+loadswuramdisk=mmc read ${initrd_addr} 0x1B000 0x21000
+swuargs=setenv bootargs console=${console} earlycon cur_slot=${bootslot} U-Boot_ver=${u-boot_version}
+swuboot=echo swuboot ramdisk; run loadswuimage; run loadswufdt; run loadswuramdisk; run swuargs; booti ${loadaddr} ${initrd_addr} ${fdt_addr}
+
+altbootusb=echo Boot Fail! Entering fastboot.; fastboot usb ${usb_port}
+altbootsingle=if test ${bootslot} = singlerescue; then run altbootusb; fi;
+		if test ${bootslot} = singlenormal; then run swuboot; fi;
+
+altbootRollbackA=echo Rolling back to slot A; setenv bootslot dualA; setenv bootcount 0; setenv upgrade_available 0; run post_opt; run bootcmd
+altbootRollbackB=echo Rolling back to slot B; setenv bootslot dualB; setenv bootcount 0; setenv upgrade_available 0; run post_opt; run bootcmd
+altbootdual=if test ${upgrade_available} = 1; then
+			if test ${bootslot} = dualA; then
+				run altbootRollbackB;
+			else
+				run altbootRollbackA;
+			fi;
+		fi;
+		run bootcmd;
+
+altbootcmd=if test ${bootslot} = singlerescue || test ${bootslot} = singlenormal; then
+			run altbootsingle;
+		else
+			run altbootdual;
+		fi;
+
 bsp_bootcmd=
 	echo Running BSP bootcmd ...;
+	if test ${bootslot} = singlerescue; then
+		run swuboot;
+	fi;
+	run adjustbootsource;
 	mmc dev ${mmcdev};
 	if mmc rescan; then
 		if run loadbootscript; then
-- 
2.43.0